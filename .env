# LocalStack configuration
LOCALSTACK_DOCKER_NAME=localstack-tesis
LOCALSTACK_VOLUME_DIR=./volume
DEBUG=0

# AWS fictitious credentials (DO NOT use real credentials here)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

# Project resource names
S3_BUCKET=tesis-security-logs
SNS_ALERTS_TOPIC=tesis-security-alerts
SNS_TRIGGERS_TOPIC=tesis-lambda-triggers
SQS_QUEUE=tesis-incident-queue
SQS_DLQ=tesis-incident-queue-dlq
LOG_GROUP_EVENTS=/tesis/security-events
LOG_GROUP_RESPONSES=/tesis/lambda-responses
