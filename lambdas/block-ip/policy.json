{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3Blocklist",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::tesis-security-logs/responses/*"
    },
    {
      "Sid": "PublishAlert",
      "Effect": "Allow",
      "Action": ["sns:Publish"],
      "Resource": "arn:aws:sns:us-east-1:000000000000:tesis-security-alerts"
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:000000000000:log-group:/tesis/lambda-responses:*"
    }
  ]
}
